# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ppmart
PORT=4000
# Secret used for HMAC (webhooks, approvals). CHANGE IN PRODUCTION.
APP_SECRET=change-me-to-a-long-random-string

# --- Member OTP delivery (at least one should be configured in production) ---
# SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PPMart <no-reply@example.com>"
# Generic SMS gateway: POST JSON {to, message} with Bearer token
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# In development (NODE_ENV!=production) OTP codes are also printed to the server log.

# --- Payment gateway (Dynamic PromptPay QR) ---
# Omise / Opn Payments secret key. When empty, PromptPay QR is generated locally
# and payments must be verified manually by a staff member with payments.verify.
OMISE_SECRET_KEY=
# Generic gateway webhook HMAC-SHA256 secret (header X-Signature)
PAYMENT_WEBHOOK_SECRET=
